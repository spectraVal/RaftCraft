# Default: detect text files and normalize line endings in Git
* text=auto

# Source code
*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf

# Web assets and structured data
*.html    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf

# Documentation and configuration
*.md         text eol=lf
*.txt        text eol=lf
*.sh         text eol=lf
*.gradle     text eol=lf
*.properties text eol=lf
*.lock       text eol=lf
Dockerfile   text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
